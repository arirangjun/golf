{
  "name": "screen-golf-reservation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "cd backend && python run.py",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
