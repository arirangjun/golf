# Railway 단일 서비스 (Next + FastAPI 같은 컨테이너)

# Railway MySQL (내부 호스트 — Railway 서비스 Variables에 설정)
DATABASE_URL="mysql://user:password@mysql.railway.internal:3306/railway"

# 같은 컨테이너 내부 FastAPI (기본값, 보통 변경 불필요)
API_URL="http://127.0.0.1:8000"

# 공개 프론트 URL (쿠키/CORS)
FRONTEND_URL="https://golf-production-b1e3.up.railway.app"

JWT_SECRET="change-this-to-a-secure-random-string-in-production"
ENVIRONMENT="production"
