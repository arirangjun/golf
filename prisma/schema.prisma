generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String        @default("")
  dong         String        @default("")
  ho           String        @default("")
  role         Role          @default(USER)
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  suggestions  Suggestion[]
  friendships  Friendship[]  @relation("FriendOwner")
  friendOf     Friendship[]  @relation("FriendTarget")

  @@index([dong, ho])
  @@index([deletedAt])
}

model Reservation {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  startHour        Int
  endHour          Int
  isSameDayBooking Boolean  @default(false)
  groupId          String?
  organizerId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([date, startHour])
  @@index([userId, date])
  @@index([date])
  @@index([groupId])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("FriendOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
}

model Suggestion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum SlotOverrideMode {
  BLOCKED
  FORCE_OPEN
}

model SlotOverride {
  id        String           @id @default(cuid())
  date      DateTime
  startHour Int
  mode      SlotOverrideMode
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([date, startHour])
  @@index([date])
}
